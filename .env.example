# ClaimFlow environment. Copy to .env and adjust:  cp .env.example .env
# .env is gitignored. Never commit real secrets.

# ---------- General ----------
TZ=Africa/Johannesburg
N8N_PORT=5678
N8N_PUBLIC_URL=http://localhost:5678/   # base for webhook + approval links (trailing slash)
MAILPIT_UI_PORT=8025
POSTGRES_PORT=5433                      # host port; 5433 avoids clashing with a local Postgres
OLLAMA_PORT=11434

# ---------- Postgres ----------
# Superuser: only used on first start to create the two databases below.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-super
# n8n's internal database (workflows, credentials, executions)
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change-me-n8n
# Application database (policies, claims, audit trail)
CLAIMFLOW_DB_USER=claimflow
CLAIMFLOW_DB_PASSWORD=change-me-claimflow

# ---------- n8n ----------
# Encrypts credentials stored by n8n. Generate one with:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string

# ---------- LLM ----------
# mock | openai | anthropic | ollama   (mock needs no key and is used by the tests)
LLM_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OLLAMA_MODEL=llama3.2:3b               # pull first: docker compose exec ollama ollama pull llama3.2:3b

# ---------- Email routing (all delivered to Mailpit locally) ----------
CLAIMFLOW_FROM_EMAIL=claims@acmecover.example
CLAIMFLOW_FRAUD_TEAM_EMAIL=fraud-team@acmecover.example
CLAIMFLOW_OPS_EMAIL=ops@acmecover.example
CLAIMFLOW_REVIEW_TIMEOUT_HOURS=24       # fraud review escalates after this

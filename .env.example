# ClaimFlow environment. `docker compose run --rm init` creates .env from this file and
# generates every placeholder secret below. .env is gitignored. Never commit real secrets.
# After changing a setting: docker compose up -d   (re-creates n8n and re-runs deploy)

# ---------- General ----------
TZ=Africa/Johannesburg
HTTPS_PORT=8443                         # Caddy: n8n editor + webhooks
N8N_PUBLIC_URL=https://localhost:8443/  # base for webhook + approval links (trailing slash)
MAILPIT_UI_PORT=8025                    # Caddy: Mailpit web inbox (https)
POSTGRES_PORT=5433                      # host port, TLS required; 5433 avoids clashing with a local Postgres
OLLAMA_PORT=11434

# ---------- Postgres ----------
# Superuser: only used on first start to create the two databases below.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-super
# n8n's internal database (workflows, credentials, executions)
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change-me-n8n
# Application database (policies, claims, audit trail)
CLAIMFLOW_DB_USER=claimflow
CLAIMFLOW_DB_PASSWORD=change-me-claimflow

# ---------- n8n ----------
# Encrypts credentials stored by n8n. Generate one with:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string

# ---------- PII encryption (see docs/security.md) ----------
# AES-256-GCM key for name/email/phone columns, and a separate HMAC key for the email blind
# index. 32 random bytes, base64. Losing CLAIMFLOW_PII_KEY makes stored PII unreadable.
CLAIMFLOW_PII_KEY=replace-with-32-random-bytes-base64
CLAIMFLOW_PII_HMAC_KEY=replace-with-32-random-bytes-base64

# Signs Status API links so sequential claim refs can't be enumerated (32 random bytes, base64)
CLAIMFLOW_STATUS_LINK_KEY=replace-with-32-random-bytes-base64

# ---------- LLM ----------
# mock | openai | anthropic | ollama   (mock needs no key and is used by the tests)
LLM_MODE=mock
# Compose profiles to start. Set to "ollama" together with LLM_MODE=ollama to run the local LLM
# (the deploy service pulls OLLAMA_MODEL on first start).
COMPOSE_PROFILES=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna                # cheapest current model for focused high-volume tasks; gpt-4o-mini / gpt-4.1-mini shut down 2027-01-14
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OLLAMA_MODEL=llama3.2:3b               # pulled automatically by the deploy service

# ---------- Email routing (all delivered to Mailpit locally) ----------
CLAIMFLOW_FROM_EMAIL=claims@acmecover.example
CLAIMFLOW_FRAUD_TEAM_EMAIL=fraud-team@acmecover.example
CLAIMFLOW_OPS_EMAIL=ops@acmecover.example
CLAIMFLOW_REVIEW_TIMEOUT_MINUTES=1440     # fraud review escalates after this (24 h); tests use 1-2
CLAIMFLOW_SLA_HOURS=48                    # Daily Ops Report: open claims older than this are SLA breaches

# ---------- Demo mode (local demos only, NEVER production) ----------
# true = the deploy service publishes workflow 07 (claim form at /form/claim-demo, n8n login
# required, plus the Claim Trace page that shows AI output, rule flags and the audit trail),
# and keeps successful executions of the claim workflows so you can click through each node
# under Executions. That stores the (fake) personal details you type in n8n's execution data.
# false = form and trace page return 404, successful executions are not kept.
# Apply with: docker compose up -d
CLAIMFLOW_DEMO_MODE=false
